# ============================================================
# Smart Traffic Violation Detection — environment template
# Copy to .env for local dev; set these as variables on Railway for prod.
# ============================================================

# Environment: development | production
ENVIRONMENT=development
DEBUG=false

# CORS — comma-separated. In prod, set to your deployed frontend URL(s).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Media root — base directory for uploads/clips/thumbnails/evidence/models.
# Leave empty for dev (uses ./data/*); set to /data on Railway (mounted volume).
MEDIA_ROOT=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/traffic_violations
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/traffic_violations

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Storage mode: "local" (default, no external deps) or "minio"
STORAGE_MODE=local

# MinIO (only needed if STORAGE_MODE=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CLIPS=violation-clips
MINIO_BUCKET_EVIDENCE=evidence-packages

# ML
DETECTION_CONFIDENCE_THRESHOLD=0.5
HELMET_CONFIDENCE_THRESHOLD=0.4

# For ml/scripts/download_helmet_model.py (optional — only when downloading pretrained weights)
ROBOFLOW_API_KEY=
HELMET_MODEL_URL=

# Video processing
FRAME_SKIP=3
CLIP_SECONDS_BEFORE=3
CLIP_SECONDS_AFTER=3
MIN_VIOLATION_FRAMES=5

# Security
SECRET_KEY=change-me-in-production
